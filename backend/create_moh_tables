CREATE ONLINE AGGREGATE K3301_HOURS AS
    min(col33vi603) AS min_col33vi603,
    max(col33vi603) AS max_col33vi603,
    sum(col33vi603) AS sum_col33vi603,
    count(col33vi603) AS count_col33vi603,
    count(col33vi603_isvalid) AS count_col33vi603_isvalid,

    min(col33vi601) AS min_col33vi601,
    max(col33vi601) AS max_col33vi601,
    sum(col33vi601) AS sum_col33vi601,
    count(col33vi601) AS count_col33vi601,
    count(col33vi601_isvalid) AS count_col33vi601_isvalid,

    min(col33vi602) AS min_col33vi602,
    max(col33vi602) AS max_col33vi602,
    sum(col33vi602) AS sum_col33vi602,
    count(col33vi602) AS count_col33vi602,
    count(col33vi602_isvalid) AS count_col33vi602_isvalid,

    min(col33vi604) AS min_col33vi604,
    max(col33vi604) AS max_col33vi604,
    sum(col33vi604) AS sum_col33vi604,
    count(col33vi604) AS count_col33vi604,
    count(col33vi604_isvalid) AS count_col33vi604_isvalid,

    min(col33si501a) AS min_col33si501a,
    max(col33si501a) AS max_col33si501a,
    sum(col33si501a) AS sum_col33si501a,
    count(col33si501a) AS count_col33si501a,
    count(col33si501a_isvalid) AS count_col33si501a_isvalid,

    min(col33pi222) AS min_col33pi222,
    max(col33pi222) AS max_col33pi222,
    sum(col33pi222) AS sum_col33pi222,
    count(col33pi222) AS count_col33pi222,
    count(col33pi222_isvalid) AS count_col33pi222_isvalid,

    min(col33pi601) AS min_col33pi601,
    max(col33pi601) AS max_col33pi601,
    sum(col33pi601) AS sum_col33pi601,
    count(col33pi601) AS count_col33pi601,
    count(col33pi601_isvalid) AS count_col33pi601_isvalid

FROM K3301
GROUP BY CTUMBLE("timestamp", INTERVAL '1' HOUR, TIMESTAMP '1970-01-01 00:00:00') "timestamp";


